NODE_ENV="development"
DATABASE_URL="postgresql://user:password@localhost:5432/bookshop"
SESSION_SECRET="your auth session secret (openssl rand -hex 32)"

ADMIN_EMAIL="initial admin email"
ADMIN_PASSWORD="initial admin password"
ADMIN_FULLNAME="initial admin fullname"
ADMIN_PHONE="initial admin phone number"
ADMIN_SEED_ENABLED="true to allow prisma db seed to create the first admin"
# ADMIN_SEED_FORCE_UPDATE="true to overwrite the existing admin on re-seed"

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Upstash Redis - backs the IP rate limiter on the auth actions.
UPSTASH_REDIS_REST_URL="your upstash redis rest url"
UPSTASH_REDIS_REST_TOKEN="your upstash redis rest token"

# Gmail SMTP - used to email 2FA codes and password-reset links.
# GMAIL_PASSWORD must be a Gmail App Password (not your account password).
GMAIL_USER="your gmail address"
GMAIL_PASSWORD="your gmail app password"
EMAIL_FROM_NAME="Harmattan Books"

# Paystack - payment rail (secret key stays server-side; no public key needed,
# checkout uses the full-redirect flow).
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_API_BASE_URL="https://api.paystack.co"

# Frog SMS (Wigal) - customer order notifications. Optional; SMS is skipped
# with a logged warning when unset.
FROG_API_KEY="your frog api key"
FROG_USERNAME="your frog username"
FROG_SENDER_ID="Harmattan"

# Shared secret for POST /api/revalidate (seed + out-of-band cache purges)
REVALIDATE_SECRET="generate with: openssl rand -hex 24"
